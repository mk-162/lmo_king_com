---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/layouts/partials/PageHeader.astro";

import Notice from "@/layouts/shortcodes/Notice";

// Get plan parameter from URL if it exists
const { url } = Astro;
const plan = url.searchParams.get('plan') || '';
---

<Base>
  <PageHeader title="Get in Touch" />

  <section class="section">
    <div class="container">
      <div class="row gy-4">
        <!-- Contact Form -->
        <div class="lg:col-7">
          <div class="rounded-lg bg-theme-light dark:bg-darkmode-theme-light p-8">
            <h2 class="mb-6">Send us a message</h2>

            {plan && (
              <Notice client:load type="info">
                <p>
                  Interested in the <strong>{plan.charAt(0).toUpperCase() + plan.slice(1)}</strong> plan?
                  Fill out the form below and we'll get back to you shortly.
                </p>
              </Notice>
            )}

            <form
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-6"
            >
              {/* Netlify form attributes */}
              <input type="hidden" name="form-name" value="contact" />

              {/* Honeypot for spam protection */}
              <div class="hidden">
                <label>
                  Don't fill this out if you're human: <input name="bot-field" />
                </label>
              </div>

              {/* Plan field (hidden, populated from URL) */}
              {plan && (
                <input type="hidden" name="interested_plan" value={plan} />
              )}

              {/* Name field */}
              <div>
                <label for="name" class="mb-2 block font-semibold">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="form-input w-full rounded-lg border border-border px-4 py-3 dark:border-darkmode-border dark:bg-darkmode-body"
                  placeholder="John Doe"
                />
              </div>

              {/* Email field */}
              <div>
                <label for="email" class="mb-2 block font-semibold">
                  Email Address <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="form-input w-full rounded-lg border border-border px-4 py-3 dark:border-darkmode-border dark:bg-darkmode-body"
                  placeholder="john@example.com"
                />
              </div>

              {/* Company field */}
              <div>
                <label for="company" class="mb-2 block font-semibold">
                  Company / Organization
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="form-input w-full rounded-lg border border-border px-4 py-3 dark:border-darkmode-border dark:bg-darkmode-body"
                  placeholder="Acme Corp"
                />
              </div>

              {/* Phone field */}
              <div>
                <label for="phone" class="mb-2 block font-semibold">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="form-input w-full rounded-lg border border-border px-4 py-3 dark:border-darkmode-border dark:bg-darkmode-body"
                  placeholder="+44 20 1234 5678"
                />
              </div>

              {/* Inquiry type */}
              <div>
                <label for="inquiry_type" class="mb-2 block font-semibold">
                  What can we help you with? <span class="text-red-500">*</span>
                </label>
                <select
                  id="inquiry_type"
                  name="inquiry_type"
                  required
                  class="form-select w-full rounded-lg border border-border px-4 py-3 dark:border-darkmode-border dark:bg-darkmode-body"
                >
                  <option value="">Select an option...</option>
                  <option value="general" selected={!plan}>General Inquiry</option>
                  <option value="sales" selected={plan === 'business' || plan === 'enterprise'}>Sales / Demo Request</option>
                  <option value="support">Technical Support</option>
                  <option value="agency">Agency / White-label Partnership</option>
                  <option value="billing">Billing Question</option>
                  <option value="other">Other</option>
                </select>
              </div>

              {/* Message field */}
              <div>
                <label for="message" class="mb-2 block font-semibold">
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="6"
                  class="form-textarea w-full rounded-lg border border-border px-4 py-3 dark:border-darkmode-border dark:bg-darkmode-body"
                  placeholder="Tell us more about your needs..."
                ></textarea>
              </div>

              {/* Checkbox for agency interest */}
              <div class="flex items-start">
                <input
                  type="checkbox"
                  id="agency_interest"
                  name="agency_interest"
                  value="yes"
                  class="mr-3 mt-1 h-4 w-4 rounded border-border text-primary focus:ring-primary dark:border-darkmode-border"
                />
                <label for="agency_interest" class="text-sm">
                  I'm interested in white-label or agency partnership opportunities
                </label>
              </div>

              {/* Submit button */}
              <div>
                <button
                  type="submit"
                  class="btn btn-primary w-full md:w-auto"
                >
                  Send Message
                </button>
              </div>

              <p class="text-sm text-text-light">
                By submitting this form, you agree to our privacy policy. We'll never share your information.
              </p>
            </form>
          </div>
        </div>

        <!-- Contact Information Sidebar -->
        <div class="lg:col-5">
          <div class="space-y-6">
            <!-- Contact Methods -->
            <div class="rounded-lg bg-white p-6 dark:bg-darkmode-body">
              <h3 class="mb-6 text-xl font-bold">Get in Touch</h3>
              <div class="space-y-4">
                <div class="flex items-start">
                  📧
                  <div>
                    <div class="font-semibold">Email</div>
                    <a href="mailto:hello@lmoking.com" class="text-primary hover:underline">
                      hello@lmoking.com
                    </a>
                    <p class="text-sm text-text-light mt-1">We typically respond within 24 hours</p>
                  </div>
                </div>

                <div class="flex items-start">
                  📞
                  <div>
                    <div class="font-semibold">Phone (Business & Enterprise)</div>
                    <a href="tel:+442012345678" class="text-primary hover:underline">
                      +44 20 1234 5678
                    </a>
                    <p class="text-sm text-text-light mt-1">Available for Business and Enterprise customers</p>
                  </div>
                </div>

                <div class="flex items-start">
                  🕒
                  <div>
                    <div class="font-semibold">Office Hours</div>
                    <div class="text-text-light">
                      <div>Monday - Friday: 9am - 6pm GMT</div>
                      <div>Saturday - Sunday: Closed</div>
                    </div>
                    <p class="text-sm text-text-light mt-1">Enterprise customers have 24/7 support</p>
                  </div>
                </div>

                <div class="flex items-start">
                  📍
                  <div>
                    <div class="font-semibold">Location</div>
                    <div class="text-text-light">
                      London, United Kingdom
                    </div>
                    <p class="text-sm text-text-light mt-1">Serving clients worldwide</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Response Time -->
            <div class="rounded-lg bg-gradient p-6 text-white">
              <h4 class="mb-4 font-bold">What to Expect</h4>
              <ul class="space-y-3 text-sm">
                <li class="flex items-start">
                  <span class="mr-2">✓</span>
                  <span><strong>General inquiries:</strong> Response within 24 hours</span>
                </li>
                <li class="flex items-start">
                  <span class="mr-2">✓</span>
                  <span><strong>Sales questions:</strong> Response within 4 business hours</span>
                </li>
                <li class="flex items-start">
                  <span class="mr-2">✓</span>
                  <span><strong>Technical support:</strong> Varies by plan (see pricing)</span>
                </li>
                <li class="flex items-start">
                  <span class="mr-2">✓</span>
                  <span><strong>Agency partnerships:</strong> Response within 48 hours</span>
                </li>
              </ul>
            </div>

            <!-- Quick Links -->
            <div class="rounded-lg border border-border p-6 dark:border-darkmode-border">
              <h4 class="mb-4 font-bold">Quick Links</h4>
              <ul class="space-y-2">
                <li>
                  <a href="/pricing" class="text-primary hover:underline">
                    View Pricing Plans →
                  </a>
                </li>
                <li>
                  <a href="/what-is-lmo" class="text-primary hover:underline">
                    What is LMO? →
                  </a>
                </li>
                <li>
                  <a href="/white-label" class="text-primary hover:underline">
                    Agency Partnerships →
                  </a>
                </li>
                <li>
                  <a href="/support" class="text-primary hover:underline">
                    Support Portal →
                  </a>
                </li>
              </ul>
            </div>

            <!-- Book a Demo CTA -->
            <div class="rounded-lg bg-theme-light p-6 text-center dark:bg-darkmode-theme-light">
              <h4 class="mb-3 font-bold">Need a Demo?</h4>
              <p class="mb-4 text-sm text-text-light">
                Schedule a personalized demo to see how LMO King can help your business.
              </p>
              <a href="/signup?plan=professional" class="btn btn-primary w-full">
                Book a Demo Call
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section-sm bg-gradient">
    <div class="container">
      <div class="row justify-center">
        <div class="md:col-10 lg:col-8 text-center text-white">
          <h2 class="mb-4">Have Questions Before Reaching Out?</h2>
          <p class="mb-6 text-lg opacity-90">
            Check out our comprehensive FAQ sections for quick answers:
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/what-is-lmo#faq" class="btn btn-outline-primary border-white text-white hover:bg-white hover:text-primary">
              LMO FAQs
            </a>
            <a href="/pricing#faq" class="btn btn-outline-primary border-white text-white hover:bg-white hover:text-primary">
              Pricing FAQs
            </a>
            <a href="/support" class="btn btn-outline-primary border-white text-white hover:bg-white hover:text-primary">
              Support Portal
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
