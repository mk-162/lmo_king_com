---
import Base from "@/layouts/Base.astro";
import Hero from "@/layouts/components/Hero.astro";
---

<Base>
  <!-- Hero Section -->
  <Hero
    title="Win the LLM Land Grab:<br/>Your Customers Are Asking AI About You"
    subtitle="Language Model Optimization (LMO)"
    description="Position your brand in ChatGPT, Claude, and Perplexity responses before your competitors do. LMO is the evolution beyond AEO—optimize your content for AI discovery."
    primaryCTA={{
      text: "Start Free - 20 Generations",
      url: "/signup"
    }}
    secondaryCTA={{
      text: "See Plans & Pricing",
      url: "/pricing"
    }}
    centered={true}
  />

  <!-- Trust Indicators -->
  <section class="section-sm bg-gradient">
    <div class="container">
      <div class="row justify-center text-center">
        <div class="md:col-10">
          <p class="mb-6 text-lg text-text-light">Trusted by content teams & agencies worldwide</p>
          <div class="flex flex-wrap items-center justify-center gap-8 opacity-60">
            <!-- Placeholder for client logos -->
            <div class="text-2xl font-bold text-text-light">Content Teams</div>
            <div class="text-2xl font-bold text-text-light">Agencies</div>
            <div class="text-2xl font-bold text-text-light">Freelancers</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="section">
    <div class="container">
      <div class="row justify-center text-center mb-12">
        <div class="md:col-10 lg:col-8">
          <h2 class="mb-4">The Search Landscape Is Shifting</h2>
          <p class="text-lg text-text-light">AI language models are changing how people discover information—and your brand needs to adapt</p>
        </div>
      </div>
      <div class="row gy-4">
        <div class="md:col-6 lg:col-3">
          <div class="rounded-lg bg-theme-light p-8 text-center dark:bg-darkmode-theme-light">
            <div class="mb-4 text-4xl">
              👥
            </div>
            <h3 class="mb-2 text-3xl font-bold">60%</h3>
            <p class="text-text-light">Of users now consult AI before searching Google</p>
          </div>
        </div>
        <div class="md:col-6 lg:col-3">
          <div class="rounded-lg bg-theme-light p-8 text-center dark:bg-darkmode-theme-light">
            <div class="mb-4 text-4xl">
              📈
            </div>
            <h3 class="mb-2 text-3xl font-bold">43%</h3>
            <p class="text-text-light">Decline in Google search click-through rates since 2023</p>
          </div>
        </div>
        <div class="md:col-6 lg:col-3">
          <div class="rounded-lg bg-theme-light p-8 text-center dark:bg-darkmode-theme-light">
            <div class="mb-4 text-4xl">
              🚀
            </div>
            <h3 class="mb-2 text-3xl font-bold">200M+</h3>
            <p class="text-text-light">Weekly ChatGPT users asking questions about products and services</p>
          </div>
        </div>
        <div class="md:col-6 lg:col-3">
          <div class="rounded-lg bg-theme-light p-8 text-center dark:bg-darkmode-theme-light">
            <div class="mb-4 text-4xl">
              💡
            </div>
            <h3 class="mb-2 text-3xl font-bold">&lt;5%</h3>
            <p class="text-text-light">Of businesses have optimized for LLM visibility (first-mover advantage)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem/Solution Comparison -->
  <section class="section-sm bg-gradient">
    <div class="container">
      <div class="row justify-center text-center mb-12">
        <div class="md:col-10 lg:col-8">
          <h2 class="mb-4">Search vs LLM Discovery</h2>
          <p class="text-lg text-text-light">The way customers discover businesses has fundamentally changed</p>
        </div>
      </div>
      <div class="row gy-4">
        <div class="md:col-6">
          <div class="rounded-lg bg-white p-8 dark:bg-darkmode-body h-full">
            <h3 class="mb-6 text-xl font-bold">❌ Traditional Search (Declining)</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="mr-3 text-red-500">•</span>
                <span class="text-text-light">Users have to click through multiple websites</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-red-500">•</span>
                <span class="text-text-light">Ad-heavy results reduce trust</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-red-500">•</span>
                <span class="text-text-light">Time-consuming research process</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-red-500">•</span>
                <span class="text-text-light">Only optimized for keywords, not answers</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:col-6">
          <div class="rounded-lg bg-primary p-8 text-white dark:bg-primary h-full">
            <h3 class="mb-6 text-xl font-bold">✅ LLM Discovery (Growing)</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-white">✓</span>
                <span>Instant, comprehensive answers with brand citations</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-white">✓</span>
                <span>Higher trust—no ads, just helpful information</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-white">✓</span>
                <span>Conversational, natural discovery process</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-white">✓</span>
                <span>Optimized for authority and helpful content</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is LMO Explainer -->
  <section class="section">
    <div class="container">
      <div class="row items-center">
        <div class="mb-8 md:col-6 lg:mb-0">
          <h2 class="mb-4">What is Language Model Optimization?</h2>
          <p class="mb-6 text-lg text-text-light">
            LMO is the practice of optimizing your content and brand presence so that AI language models
            (like ChatGPT, Claude, Perplexity, and Gemini) cite and recommend your business when users
            ask relevant questions.
          </p>
          <p class="mb-6 text-text-light">
            It's the evolution beyond SEO (Search Engine Optimization) and AEO (Answer Engine Optimization).
            While SEO focuses on ranking in search results and AEO targets featured snippets, LMO ensures
            your brand appears in AI-generated responses.
          </p>
          <div class="mb-8 rounded-lg bg-theme-light p-6 dark:bg-darkmode-theme-light">
            <h4 class="mb-4 font-bold">The Evolution:</h4>
            <div class="flex items-center justify-between text-center">
              <div>
                <div class="mb-2 text-2xl">📊</div>
                <div class="font-semibold">SEO</div>
                <div class="text-sm text-text-light">2000s</div>
              </div>
              <div class="text-2xl text-text-light">→</div>
              <div>
                <div class="mb-2 text-2xl">💡</div>
                <div class="font-semibold">AEO</div>
                <div class="text-sm text-text-light">2010s</div>
              </div>
              <div class="text-2xl text-text-light">→</div>
              <div>
                <div class="mb-2 text-2xl">🤖</div>
                <div class="font-semibold">LMO</div>
                <div class="text-sm text-text-light">2024+</div>
              </div>
            </div>
          </div>
          <a href="/what-is-lmo" class="btn btn-primary">Learn More About LMO</a>
        </div>
        <div class="md:col-6">
          <div class="rounded-lg bg-gradient p-8">
            <h4 class="mb-6 font-bold text-white">Why LMO Matters Now</h4>
            <ul class="space-y-4 text-white">
              <li class="relative pl-6">
                <span class="absolute left-0 top-1.5 text-primary">✓</span>
                <span><strong>First-Mover Advantage:</strong> LLMs learn from existing content—early citations compound</span>
              </li>
              <li class="relative pl-6">
                <span class="absolute left-0 top-1.5 text-primary">✓</span>
                <span><strong>Land Grab Window:</strong> Less than 5% of businesses are optimizing for LLMs</span>
              </li>
              <li class="relative pl-6">
                <span class="absolute left-0 top-1.5 text-primary">✓</span>
                <span><strong>Behavioral Shift:</strong> 60% of users now consult AI before traditional search</span>
              </li>
              <li class="relative pl-6">
                <span class="absolute left-0 top-1.5 text-primary">✓</span>
                <span><strong>Future-Proofing:</strong> Position your brand for the AI-first discovery era</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section-sm bg-gradient">
    <div class="container">
      <div class="row justify-center text-center mb-12">
        <div class="md:col-10 lg:col-8">
          <h2 class="mb-4">Trusted by Content Teams & Agencies</h2>
          <p class="text-lg text-text-light">See what our users are saying about LMO King</p>
        </div>
      </div>
      <div class="row gy-4">
        <div class="md:col-6 lg:col-4">
          <div class="rounded-lg bg-white p-6 dark:bg-darkmode-body h-full">
            <div class="mb-4 flex items-center">
              <div class="mr-4 h-12 w-12 rounded-full bg-primary"></div>
              <div>
                <div class="font-bold">Sarah Mitchell</div>
                <div class="text-sm text-text-light">Content Manager • Tech Startup</div>
              </div>
            </div>
            <p class="mb-4 italic text-text-light">
              "We started getting cited in ChatGPT responses within 2 weeks. Our brand visibility in AI
              search has increased dramatically—this is the future of content discovery."
            </p>
            <div class="text-sm font-semibold text-primary">Professional Plan</div>
          </div>
        </div>
        <div class="md:col-6 lg:col-4">
          <div class="rounded-lg bg-white p-6 dark:bg-darkmode-body h-full">
            <div class="mb-4 flex items-center">
              <div class="mr-4 h-12 w-12 rounded-full bg-primary"></div>
              <div>
                <div class="font-bold">Alex Chen</div>
                <div class="text-sm text-text-light">Agency Owner • Digital Marketing</div>
              </div>
            </div>
            <p class="mb-4 italic text-text-light">
              "LMO King has become essential for our agency. We manage 20+ clients and the bulk operations
              save us hours. Our clients are thrilled to be ahead of their competition."
            </p>
            <div class="text-sm font-semibold text-primary">Business Plan</div>
          </div>
        </div>
        <div class="md:col-6 lg:col-4">
          <div class="rounded-lg bg-white p-6 dark:bg-darkmode-body h-full">
            <div class="mb-4 flex items-center">
              <div class="mr-4 h-12 w-12 rounded-full bg-primary"></div>
              <div>
                <div class="font-bold">James Rodriguez</div>
                <div class="text-sm text-text-light">Freelance SEO Consultant</div>
              </div>
            </div>
            <p class="mb-4 italic text-text-light">
              "The free tier let me test it with my own site first. Once I saw results, upgrading to
              Starter was a no-brainer. Now I offer LMO as a premium service to clients."
            </p>
            <div class="text-sm font-semibold text-primary">Starter Plan</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Preview -->
  <section class="section">
    <div class="container">
      <div class="row justify-center text-center mb-12">
        <div class="md:col-10 lg:col-8">
          <h2 class="mb-4">Simple, Transparent Pricing</h2>
          <p class="text-lg text-text-light">Start free, scale as you grow. No credit card required.</p>
        </div>
      </div>
      <div class="row gy-4 justify-center">
        <div class="md:col-6 lg:col-4">
          <div class="rounded-lg border-2 border-border p-8 text-center dark:border-darkmode-border h-full flex flex-col">
            <h3 class="mb-2 text-2xl font-bold">Free</h3>
            <div class="mb-4">
              <span class="text-4xl font-bold">£0</span>
              <span class="text-text-light">/month</span>
            </div>
            <p class="mb-6 text-text-light">Perfect for testing LMO</p>
            <ul class="mb-8 space-y-3 text-left flex-grow">
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>20 AI generations/month</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>1 project</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>Basic features</span>
              </li>
            </ul>
            <a href="/signup" class="btn btn-outline-primary">Start Free</a>
          </div>
        </div>
        <div class="md:col-6 lg:col-4">
          <div class="rounded-lg border-2 border-primary bg-theme-light p-8 text-center dark:bg-darkmode-theme-light relative h-full flex flex-col">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1 text-sm font-semibold text-white">
              Most Popular
            </div>
            <h3 class="mb-2 text-2xl font-bold">Professional</h3>
            <div class="mb-4">
              <span class="text-4xl font-bold">£199</span>
              <span class="text-text-light">/month</span>
            </div>
            <p class="mb-6 text-text-light">For content teams & agencies</p>
            <ul class="mb-8 space-y-3 text-left flex-grow">
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>2,000 generations/month</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>10 projects, 3 team members</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>Advanced AI research</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>Priority queue (2× faster)</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>API access (read-only)</span>
              </li>
            </ul>
            <a href="/signup?plan=professional" class="btn btn-primary">Start Free Trial</a>
          </div>
        </div>
        <div class="md:col-6 lg:col-4">
          <div class="rounded-lg border-2 border-border p-8 text-center dark:border-darkmode-border h-full flex flex-col">
            <h3 class="mb-2 text-2xl font-bold">Business</h3>
            <div class="mb-4">
              <span class="text-4xl font-bold">£599</span>
              <span class="text-text-light">/month</span>
            </div>
            <p class="mb-6 text-text-light">For agencies & enterprises</p>
            <ul class="mb-8 space-y-3 text-left flex-grow">
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>10,000 generations/month</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>50 projects, 10 team members</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>Full REST API</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>Priority queue (3× faster)</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 mt-1 flex-shrink-0 text-primary">✓</span>
                <span>Phone support</span>
              </li>
            </ul>
            <a href="/contact?plan=business" class="btn btn-outline-primary">Book Demo</a>
          </div>
        </div>
      </div>
      <div class="row justify-center mt-8">
        <div class="md:col-10 lg:col-8 text-center">
          <a href="/pricing" class="text-primary hover:underline">View all plans and detailed comparison →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="section-sm bg-gradient">
    <div class="container">
      <div class="row justify-center text-center">
        <div class="md:col-10 lg:col-8">
          <h2 class="mb-4 text-white">Ready to Win the LLM Land Grab?</h2>
          <p class="mb-8 text-xl text-white/90">
            Start optimizing your content for AI discovery today. No credit card required.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/signup" class="btn btn-primary bg-white text-primary hover:bg-white/90">
              Start Free - 20 Generations
            </a>
            <a href="/what-is-lmo" class="btn btn-outline-primary border-white text-white hover:bg-white hover:text-primary">
              Learn More About LMO
            </a>
          </div>
          <p class="mt-6 text-sm text-white/80">
            Free tier • No credit card required • Upgrade anytime
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
